ui,言語選択/@language:over,		@language:over
ui,言語選択/@language:off,		@language:off/button
#
ui,言語選択/@language:rect,		#lang
ui,言語選択/ボタン/@_gauge_r:over,	$lang@_r:over
ui,言語選択/ボタン/@_gauge_r:off,	$lang@_r:off
ui,言語選択/ボタン/@_gauge_l:over,	$lang@_l:over
ui,言語選択/ボタン/@_gauge_l:off,	$lang@_l:off
ui,言語選択/@language:rect,		$lang@:rect
ui,言語選択/@language:over,		$lang@:over
ui,言語選択/@language:off,		$lang@:off/button
